// Write a program to Check whether a number is prime. 
#include<stdio.h>
int main()
{
    int n ,i,count;
    printf("Enter the number");
    scanf("%d",&n);
    for(i=2 ;i<n ;i++)
    {
      if(n%i==0)
      {
        count++;
      }
    }
      if(count!=0)
      {
       printf("Entered number is not prime");
      }  
      else
      {
      printf("Entered number is  prime");
      }
    return 0;
}
